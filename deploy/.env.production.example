# Safe production environment template. Copy privately on the server; do not commit real values.

NODE_ENV=production

# Application URL
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_OSRS_SERVICES_LOGO_SRC=/branding/osrs-services-logo.png
NEXT_PUBLIC_DISCORD_URL=

# MySQL 8 database
DATABASE_URL=mysql://osrs_app:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:3306/osrs_services
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=osrs_app
DATABASE_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
DATABASE_NAME=osrs_services
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Staff and customer sessions
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_COOKIE=osrs_session
CUSTOMER_SESSION_COOKIE=osrs_customer_session
SESSION_TTL_HOURS=168

# RSN eligibility HMAC and rate-limit configuration
ELIGIBILITY_HMAC_SECRET=REPLACE_WITH_SEPARATE_AT_LEAST_32_RANDOM_CHARACTERS
RSN_PROVIDER_TIMEOUT_MS=4000
RSN_CACHE_TTL_SECONDS=300
RSN_NEGATIVE_CACHE_TTL_SECONDS=60
RSN_RATE_LIMIT_WINDOW_SECONDS=60
RSN_RATE_LIMIT_COUNT=8
RSN_TRUST_PROXY_IP_HEADER=false
RSN_DEVELOPMENT_FIXTURE=false

# Private attachment storage. Keep outside public/ and back it up.
CUSTOM_BUILD_PRIVATE_ATTACHMENT_ROOT=/var/lib/osrs-services/private/custom-build-attachments

# Payment boundary. Manual review is the only launch-safe default.
PAYMENT_PROVIDER=MANUAL_REVIEW
EXTERNAL_PAYMENTS_ENABLED=false
PAYMENT_WEBHOOKS_ENABLED=false
PAYMENT_REFUNDS_ENABLED=false
TEST_HOSTED_PAYMENT_SECRET=

# Email delivery. Keep disabled until SMTP launch procedure is complete.
EMAIL_DELIVERY_ENABLED=false
EMAIL_TRANSPORT=SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OSRS Services

# Task 015 Socket.IO gateway. Use explicit origins only; never use "*".
CHAT_SOCKET_PORT=3001
CHAT_SOCKET_PATH=/socket.io
CHAT_ALLOWED_ORIGINS=https://example.com
CHAT_GUEST_COOKIE=osrs_chat_guest
NEXT_PUBLIC_CHAT_SOCKET_URL=https://example.com
NEXT_PUBLIC_CHAT_SOCKET_PATH=/socket.io

# Optional one-time admin seed. Leave blank unless deliberately creating or resetting an admin.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Production Super Admin
ADMIN_SEED_RESET_PASSWORD=false
