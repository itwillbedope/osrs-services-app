{
  "name": "osrs-services-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-runtime-dependencies.mjs && prisma generate && node scripts/hostinger-sql-migrate.mjs && node --import tsx prisma/seed.ts",
    "build": "next build --webpack",
    "prestart": "node scripts/check-runtime-dependencies.mjs",
    "start": "next start",
    "runtime:check": "node scripts/check-runtime-dependencies.mjs",
    "compatibility:check": "node scripts/check-wasm-compatibility.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.next-config.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:seed": "vitest run src/tests/seed-idempotence.test.ts",
    "test:hostinger-migrate": "vitest run src/tests/hostinger-sql-migrate.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "chat:dev": "tsx realtime/chat-server.ts",
    "chat:start": "node --import tsx realtime/chat-server.ts",
    "chat:check": "tsx scripts/check-task015-chat.ts",
    "production:check": "tsx scripts/validate-production-readiness.ts",
    "pricing:reference-check": "tsx scripts/validate-reference-pricing.ts",
    "finalization:artifacts": "tsx scripts/generate-finalization-artifacts.ts",
    "production:smoke": "tsx scripts/production-smoke-test.ts",
    "payments:check": "tsx --conditions react-server scripts/validate-task016-payments.ts",
    "screenshots:task001": "tsx scripts/capture-task-001.ts",
    "screenshots:task002": "tsx scripts/capture-task-002.ts",
    "screenshots:task003": "tsx scripts/capture-task-003.ts",
    "screenshots:task004": "tsx scripts/capture-task-004.ts",
    "screenshots:task005": "tsx scripts/capture-task-005.ts",
    "screenshots:task006": "tsx scripts/capture-task-006.ts",
    "screenshots:task007": "tsx scripts/capture-task-007.ts",
    "screenshots:task008": "tsx scripts/capture-task-008.ts",
    "screenshots:task009": "tsx scripts/capture-task-009.ts",
    "screenshots:task010": "tsx scripts/capture-task-010.ts",
    "screenshots:task011": "tsx scripts/capture-task-011.ts",
    "screenshots:task012": "tsx scripts/capture-task-012.ts",
    "screenshots:task013": "tsx scripts/capture-task-013.ts",
    "screenshots:task014": "tsx scripts/capture-task-014.ts",
    "screenshots:task015": "tsx scripts/capture-task-015.ts",
    "screenshots:task016": "tsx scripts/capture-task-016.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "deploy:migrate": "node scripts/hostinger-sql-migrate.mjs",
    "deploy:seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.5",
    "@next/swc-wasm-nodejs": "16.3.8",
    "@node-rs/argon2": "2.1.0",
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-slot": "1.3.0",
    "@swc/helpers": "0.5.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.22.0",
    "mariadb": "3.5.4",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.7",
    "stripe": "23.0.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "@hono/node-server": "1.19.15",
    "hono": "4.13.7",
    "engine.io": "6.6.10",
    "fast-uri": "3.1.8",
    "mysql2": "3.23.1",
    "valibot": "1.4.2",
    "deepmerge-ts": "8.0.0",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2",
    "nanoid@>=3.0.0 <3.3.18": "3.3.18"
  }
}
