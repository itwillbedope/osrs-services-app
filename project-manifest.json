{
  "project": "OSRS Services",
  "domain": "osrsservices.com",
  "currency": "USD",
  "region": "United States",
  "delivery_weeks": 7,
  "database": "MySQL 8",
  "framework": "Next.js App Router",
  "realtime": "Socket.IO",
  "roles": ["SUPER_ADMIN", "EDITOR", "SUPPORT_AGENT"],
  "pricing_defaults": {
    "discord_stream_percent": 2,
    "secure_100_combat_percent": 10,
    "game_mode": {
      "normal": 0,
      "iron": 10,
      "hcim": 20,
      "uim": 30
    },
    "delivery": {
      "standard": {
        "enabled": true,
        "percent": 0
      },
      "priority": {
        "enabled": false,
        "percent": null
      },
      "express": {
        "enabled": false,
        "percent": null
      }
    }
  },
  "feature_flags": {
    "catalogue_card_engine_enabled": true,
    "rsn_eligibility_enabled": false,
    "skilling_calculator_enabled": false,
    "bossing_calculator_enabled": false,
    "premium_configurator_enabled": false,
    "global_pricing_enabled": false,
    "gold_engine_enabled": false,
    "account_marketplace_enabled": false,
    "custom_account_build_enabled": false,
    "product_marketplace_enabled": false,
    "cart_enabled": false,
    "guest_checkout_enabled": false,
    "external_payments_enabled": false,
    "payment_webhooks_enabled": false,
    "payment_refunds_enabled": false,
    "customer_accounts_enabled": false,
    "customer_registration_enabled": false,
    "customer_dashboard_enabled": false,
    "live_chat_enabled": false,
    "guest_live_chat_enabled": false,
    "customer_live_chat_enabled": false,
    "chat_realtime_enabled": false
  },
  "service_engines": {
    "custom_account_build": {
      "engineType": "CUSTOM_ACCOUNT_BUILD",
      "publicRoute": "/custom-account-build",
      "adminRoute": "/admin/custom-builds",
      "featureFlag": "custom_account_build_enabled",
      "quoteOnly": true,
      "createsOrdersOrPayments": false
    },
    "product_marketplace": {
      "engineType": "PRODUCT_MARKETPLACE",
      "publicRoute": "/products",
      "adminRoute": "/admin/products",
      "featureFlag": "product_marketplace_enabled",
      "previewOnly": true,
      "createsReservationsPublicly": false,
      "createsOrdersOrPayments": false
    },
    "guest_checkout": {
      "publicRoutes": ["/cart", "/checkout", "/orders/track/[token]"],
      "adminRoutes": [
        "/admin/orders",
        "/admin/checkout",
        "/admin/checkout/payment-methods"
      ],
      "featureFlags": [
        "cart_enabled",
        "guest_checkout_enabled",
        "external_payments_enabled"
      ],
      "paymentMode": "MANUAL_REVIEW_DEFAULT_WITH_HOSTED_ADAPTER_BOUNDARY",
      "notificationDelivery": "EMAIL_DELIVERY_FOUNDATION_DISABLED_DEFAULT",
      "storesRawCartToken": false,
      "storesRawTrackingToken": false
    },
    "payments_email_launch_readiness": {
      "publicRoutes": [
        "/checkout/payment/[transactionId]/pending",
        "/checkout/payment/[transactionId]/success",
        "/checkout/payment/[transactionId]/failure",
        "/terms",
        "/privacy",
        "/refund-policy",
        "/ready"
      ],
      "adminRoutes": [
        "/admin/payments",
        "/admin/payments/[transactionId]",
        "/admin/checkout/payment-eligibility",
        "/admin/checkout/email",
        "/admin/launch-readiness"
      ],
      "apiRoutes": [
        "/api/payments/webhooks/[provider]",
        "/api/payments/test-hosted/fixtures"
      ],
      "featureFlags": [
        "external_payments_enabled",
        "payment_webhooks_enabled",
        "payment_refunds_enabled"
      ],
      "providers": ["MANUAL_REVIEW", "TEST_HOSTED", "EXTERNAL_HOSTED_CHECKOUT"],
      "defaultProvider": "MANUAL_REVIEW",
      "testProviderProductionBlocked": true,
      "realProviderConfigured": false,
      "storesRawCardData": false,
      "storesRawWebhookPayloads": false,
      "emailDeliveryDefault": "DISABLED",
      "storesRawEmailTokens": false,
      "requiresClientReview": true
    },
    "customer_accounts": {
      "publicRoutes": ["/account/login", "/account/register", "/account"],
      "adminRoutes": ["/admin/customers"],
      "featureFlags": [
        "customer_accounts_enabled",
        "customer_registration_enabled",
        "customer_dashboard_enabled"
      ],
      "sessionCookie": "osrs_customer_session",
      "accountType": "CUSTOMER",
      "emailDelivery": "NOT_CONFIGURED",
      "storesRawAuthTokens": false,
      "grantsStaffPermissions": false
    },
    "live_chat": {
      "publicRoutes": ["/support", "/account/support"],
      "adminRoutes": ["/admin/chat"],
      "featureFlags": [
        "live_chat_enabled",
        "guest_live_chat_enabled",
        "customer_live_chat_enabled",
        "chat_realtime_enabled"
      ],
      "gateway": "realtime/chat-server.ts",
      "transport": ["HTTP_FALLBACK", "SOCKET_IO_SINGLE_NODE"],
      "storesRawGuestToken": false,
      "externalProviderConfigured": false,
      "attachmentsEnabled": false,
      "multiNodeRealtime": false
    }
  }
}
